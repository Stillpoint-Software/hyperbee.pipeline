<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Pinned, not inherited: netstandard2.1 has no test host, so the suite runs on net11.0 and net10.0. -->
    <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="NSubstitute" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Hyperbee.Pipeline\Hyperbee.Pipeline.csproj" />
    <ProjectReference Include="..\..\src\Hyperbee.Pipeline.Validation\Hyperbee.Pipeline.Validation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.SourceLink.GitHub" />
  </ItemGroup>

  <!--
    Opt-in: run this suite against the netstandard2.1 build of the library instead
    of the matching net10.0/net11.0 build. netstandard2.1 is not a runtime and
    cannot host a test, so the tests still execute on net10.0 or net11.0; only the
    library under test changes.

      dotnet test test/Hyperbee.Pipeline.Validation.Tests/Hyperbee.Pipeline.Validation.Tests.csproj -f net10.0 -p:UseNetstandardAsset=true
  -->
  <ItemGroup Condition="'$(UseNetstandardAsset)' == 'true'">
    <ProjectReference Update="..\..\src\Hyperbee.Pipeline\Hyperbee.Pipeline.csproj" SetTargetFramework="TargetFramework=netstandard2.1" />
    <ProjectReference Update="..\..\src\Hyperbee.Pipeline.Validation\Hyperbee.Pipeline.Validation.csproj" SetTargetFramework="TargetFramework=netstandard2.1" />
  </ItemGroup>

</Project>
