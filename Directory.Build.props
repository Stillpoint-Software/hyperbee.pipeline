<Project>
  <PropertyGroup>
    <!-- Suppress NU1507 (multiple package sources with CPM) -->
    <NoWarn>$(NoWarn);NU1507;MSTEST0001</NoWarn>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);MSTEST0001</WarningsNotAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Nerdbank.GitVersioning" PrivateAssets="all" />
    <!--
      PrivateAssets must sit here, on the PackageReference: without it SourceLink
      was emitted as a dependency in every package's nuspec.
    -->
    <PackageReference Include="Microsoft.SourceLink.GitHub">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- SourceLink / build hygiene -->
  <PropertyGroup>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <!--
    Package metadata. This group is deliberately unconditional: a csproj sets
    IsPackable in its own body, which MSBuild evaluates after this file, so a
    Condition on IsPackable here is always false. It was, and up to 2.16.1 every
    package shipped without its license, icon and readme metadata. The properties
    do nothing in a project that does not pack.
  -->
  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>https://github.com/Stillpoint-Software/Hyperbee.Pipeline/releases/latest</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/Stillpoint-Software/Hyperbee.Pipeline</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Stillpoint-Software/Hyperbee.Pipeline</PackageProjectUrl>
  </PropertyGroup>

  <!-- Pull icon, README & LICENSE into the package root -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)assets/icon.png"
          Pack="true"
          Visible="false"
          PackagePath="/" />

    <None Include="$(MSBuildThisFileDirectory)LICENSE"
          Pack="true"
          PackagePath="\"
          Link="LICENSE" />
  </ItemGroup>
  <!-- Global project properties - .NET 11 first, older runtimes kept for compatibility -->
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      Primary target: .NET 10 (LTS), with .NET 11 (STS) for current support.
      net8.0 and net9.0 reached end of support on 2026-11-10. netstandard2.1 is the
      compatibility floor, so a net8.0 or net9.0 consumer still resolves an asset.

      Two packages cannot ship a netstandard2.1 asset: Hyperbee.Pipeline.AspNetCore
      and Hyperbee.Pipeline.Auth carry a FrameworkReference on
      Microsoft.AspNetCore.App, which only a runtime TFM resolves. They pin
      net11.0;net10.0;net8.0 in their own csproj so net8.0 consumers keep an asset.
      Test, benchmark and those two projects set their own TargetFrameworks.

      The condition keeps this off BenchmarkDotNet's generated project, which is
      written inside this tree and would otherwise inherit the plural form and fail
      with NU1201 before a benchmark runs.
    -->
    <TargetFrameworks Condition="'$(MSBuildProjectName)' != 'BenchmarkDotNet.Autogenerated'">net11.0;net10.0;netstandard2.1</TargetFrameworks>
  </PropertyGroup>

  <!--
    The SDK defaults netstandard2.1 to C# 8, which predates records, init accessors
    and C# 14 extension members. net10.0 and net11.0 already default to the SDK's
    latest, so this only affects netstandard.
  -->
  <PropertyGroup Condition="$(TargetFramework.StartsWith('netstandard'))">
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!--
    PolySharp generates the two compiler-required types netstandard2.1 lacks,
    IsExternalInit and CallerArgumentExpressionAttribute, as internal types in each
    assembly that references it. On net10.0 and net11.0, where the framework has
    them, it emits [TypeForwardedTo] instead. That forwarder is what keeps init
    accessors binding when code compiled against the netstandard2.1 asset runs on a
    net10.0+ asset; without it the call throws MissingMethodException.
  -->
  <PropertyGroup>
    <PolySharpIncludeGeneratedTypes>System.Runtime.CompilerServices.IsExternalInit;System.Runtime.CompilerServices.CallerArgumentExpressionAttribute</PolySharpIncludeGeneratedTypes>
  </PropertyGroup>
</Project>
